POSTGRES_DB=mtglogger
POSTGRES_USER=mtglogger
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://mtglogger:change-me@db:5432/mtglogger
SCRYFALL_USER_AGENT=MTGLogger/0.1 (your-email@example.com)
PRICE_REFRESH_HOURS=12
# Leave blank to use the web container's same-origin /api proxy (recommended).
VITE_API_URL=
CORS_ORIGINS=http://localhost:5173
API_BIND=127.0.0.1
API_PORT=8000
WEB_BIND=0.0.0.0
WEB_PORT=5173
